{
  "expo": {
    "name": "SlugNav",
    "slug": "slugnav",
    "version": "0.1.0",
    "scheme": "slugnav",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SlugNav uses your location only to show nearby places. It isn't saved or shared."
        }
      ],
      "expo-status-bar"
    ]
  }
}
