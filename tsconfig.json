{
  "compilerOptions": {
    "strict": true,
    "jsx": "react",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "supabase/functions/**/handler.ts"
  ],
  "exclude": ["**/*.md", "node_modules", ".husky", ".vscode"]
}
