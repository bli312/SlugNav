    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "test-renderer": "^1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export",
    "scrape:local": "npx tsx ./src/util/pisa/pisa-scraper-local.ts",
    "scrape:export": "npx tsx ./src/util/pisa/pisa-scraper-export.ts",
    "locations:export": "npx tsx ./src/util/export-locations.ts",
    "typecheck": "tsc --noEmit",
    "check:scripts": "npm run typecheck && npm run lint && npm run test:coverage",
    "lint": "eslint .",
    "format": "prettier --write **/*.{js,jsx,ts,tsx,json}",
    "test": "node --experimental-strip-types --test && jest --runInBand",
    "test:coverage": "c8 node --experimental-strip-types --test && jest --runInBand --coverage",
    "prepare": "husky"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts",
      "supabase/functions/**/handler.ts"
    ],
    "exclude": [
      "src/**/*.d.ts",
      "src/**/types.ts"
    ],
    "reporter": [
      "text",
      "lcovonly"
    ],
    "reports-dir": "coverage/node"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts",
      "<rootDir>/tests/**/*.spec.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/types.ts"
    ],
    "coverageDirectory": "coverage/components",
    "coverageReporters": [
      "text",
      "lcovonly"
    ]
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "acorn": "^8.19.0",
