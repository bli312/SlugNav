    "concat-map": "^0.0.1",
    "cross-spawn": "^7.0.6",
    "debug": "^4.4.3",
    "deep-is": "^0.1.4",
    "dotenv": "^18.0.9",
    "escape-string-regexp": "^4.0.0",
    "eslint-scope": "^8.4.0",
